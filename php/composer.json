{
  "name": "gsoultan/anubis-sdk",
  "description": "PHP client for authenticating and authorising against an Anubis identity service",
  "keywords": ["anubis", "sso", "oidc", "paseto", "authorization", "rbac"],
  "homepage": "https://github.com/gsoultan/anubis-sdk",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-sodium": "*"
  },
  "autoload": {
    "psr-4": { "Anubis\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Anubis\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": { "sort-packages": true }
}
